# Copy this file to .env (backend) and/or .env.local (frontend).
# Never commit the filled-in version — get real values from the project owner
# via a password manager, not Slack/email.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- MyScript iink ---
MYSCRIPT_APP_KEY=
MYSCRIPT_HMAC_KEY=

# --- LLM (ticket #67, 2nd MVP - rule/hint authoring, live hint escalation) ---
# LLM_PROVIDER: "anthropic" (default) or "openai_compatible".
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL only applies to LLM_PROVIDER=openai_compatible - defaults to OpenAI's own
# API if unset. Point it at another OpenAI-compatible endpoint (OpenRouter, Hugging Face's
# router, Together.ai, Groq, DeepSeek, Moonshot/Kimi, or a self-hosted vLLM/Ollama server)
# to swap models/vendors with no code change - just this URL + LLM_MODEL + LLM_API_KEY.
LLM_BASE_URL=
# Per-account lifetime cap on live-hint LLM tokens (backend/parents.py) - defaults to
# 20000 if unset. A config value, not a code change, once real usage data exists.
LLM_TOKEN_LIMIT_PER_ACCOUNT=

# --- Backend URL (used by frontend to call the API) ---
BACKEND_API_URL=http://localhost:8000
# Same URL, exposed to the browser bundle for client-side fetches (e.g. ink capture -> /recognize).
# Not a secret - just an endpoint address - safe to expose, unlike the keys above.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000

# --- Supabase, frontend copies (3rd MVP - parent auth) ---
# Same project as SUPABASE_URL/SUPABASE_ANON_KEY above, exposed to the browser bundle -
# the anon key is meant to be public (RLS/policies do the real access control), this is
# what the frontend uses to talk to Supabase Auth directly for parent sign-up/sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
