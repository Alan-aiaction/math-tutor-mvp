# Copy this file to .env (backend) and/or .env.local (frontend).
# Never commit the filled-in version — get real values from the project owner
# via a password manager, not Slack/email.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- MyScript iink ---
MYSCRIPT_APP_KEY=
MYSCRIPT_HMAC_KEY=

# --- Backend URL (used by frontend to call the API) ---
BACKEND_API_URL=http://localhost:8000
# Same URL, exposed to the browser bundle for client-side fetches (e.g. ink capture -> /recognize).
# Not a secret - just an endpoint address - safe to expose, unlike the keys above.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
